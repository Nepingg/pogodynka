<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Pogodynka{% endblock %}</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_location_index') }}">
            Pogodynka
        </a>

        <div class="navbar-nav">
            <a class="nav-link" href="{{ path('app_location_index') }}">
                Locations
            </a>
            <a class="nav-link" href="{{ path('app_forecast_index') }}">
                Forecasts
            </a>
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a class="nav-link" href="{{ path('app_login') }}">Login</a>
            {% endif %}
        </div>
    </div>
</nav>
<body>
<style>
    body{
        background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=57878");
    }
</style>
<main class="container py-4">
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
